<Window
    x:Class="ColourPicker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ColourPicker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ColourPicker"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
    mc:Ignorable="d">

    <Window.Resources>
        <LinearGradientBrush x:Key="HatchBrush" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="8,8">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.75" Color="Transparent" />
            <GradientStop Offset="0.75" Color="Black" />
            <GradientStop Offset="1" Color="Black" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Width="350" Orientation="Vertical">
                <local:SliderControl DataContext="{Binding HueSlider}" />
                <local:SliderControl DataContext="{Binding SaturationSlider}" />
                <local:SliderControl DataContext="{Binding LightnessSlider}" />
            </StackPanel>

            <Rectangle
                Width="1"
                Margin="5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Fill="Black" />

            <StackPanel Width="350" Orientation="Vertical">
                <local:SliderControl DataContext="{Binding RedSlider}" />
                <local:SliderControl DataContext="{Binding GreenSlider}" />
                <local:SliderControl DataContext="{Binding BlueSlider}" />
            </StackPanel>

            <Rectangle
                Width="1"
                Margin="5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Fill="Black" />

            <local:VerticalSliderControl DataContext="{Binding AlphaSlider}" />
        </StackPanel>

        <Rectangle
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Fill="{StaticResource HatchBrush}" />

        <Rectangle
            Grid.Row="1"
            Height="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Fill="Black" />

        <Rectangle
            Grid.Row="1"
            Height="40"
            Margin="10"
            HorizontalAlignment="Stretch"
            Fill="{Binding Colour}" />
    </Grid>
</Window>